---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PublicationCard from '../components/PublicationCard.astro';
import PublicationRow from '../components/PublicationRow.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { alternatesFor, homePath, sectionPath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { subjectIds } from '../data/subjects';
import { bySubject, forLocale, getPublications } from '../lib/publications';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const all = await getPublications();
const shown = forLocale(all, locale);
const featured = shown.filter((entry) => entry.data.featured).slice(0, 3);
const recent = shown.filter((entry) => !featured.includes(entry)).slice(0, 5);
const languages = new Set(all.map((entry) => entry.data.lang)).size;
const activeSubjects = subjectIds.filter((id) => bySubject(shown, id).length > 0).length;
---

<Base locale={locale} title={t.meta.homeTitle} description={t.meta.homeDescription} alternates={alternatesFor(homePath)}>
  <section class="hero">
    <div class="aurora" aria-hidden="true">
      <span class="blob blob--violet"></span>
      <span class="blob blob--blue"></span>
      <span class="grid"></span>
    </div>

    <div class="container">
      <p class="eyebrow" data-reveal><span class="dot"></span>{t.home.eyebrow}</p>
      <h1 data-reveal style="--d: 80ms">
        {t.home.titleLead}<br />
        <em class="gradient-text">{t.home.titleAccent}</em>
      </h1>
      <div class="lead">
        <p class="intro" data-reveal style="--d: 160ms">{t.home.intro}</p>
        <div class="actions" data-reveal style="--d: 240ms">
          <a class="btn btn--primary" href={sectionPath(locale, 'publications')}>{t.home.ctaPrimary}<Arrow /></a>
          <a class="btn btn--ghost" href={`${sectionPath(locale, 'about')}#approach`}>{t.home.ctaSecondary}</a>
        </div>
      </div>

      <dl class="stats" data-reveal style="--d: 320ms">
        <div><dt>{t.home.statPublications}</dt><dd>{String(shown.length).padStart(2, '0')}</dd></div>
        <div><dt>{t.home.statSubjects}</dt><dd>{String(activeSubjects).padStart(2, '0')}</dd></div>
        <div><dt>{t.home.statLanguages}</dt><dd>{String(languages).padStart(2, '0')}</dd></div>
      </dl>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section featured" aria-labelledby="featured-title">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="label" data-index="01">{t.home.featuredLabel}</p>
              <h2 class="h2" id="featured-title">{t.home.featuredTitle}</h2>
            </div>
          </div>
          <div class:list={['feature-grid', `feature-grid--${featured.length}`]}>
            {featured.map((entry, i) => (
              <PublicationCard entry={entry} all={all} locale={locale} size="feature" delay={i * 90} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section recent" aria-labelledby="recent-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="label" data-index="02">{t.home.recentLabel}</p>
          <h2 class="h2" id="recent-title">{t.home.recentTitle}</h2>
        </div>
        <a class="text-link" href={sectionPath(locale, 'publications')}>{t.home.recentAll}<Arrow /></a>
      </div>
      <ol class="rows">
        {recent.map((entry, i) => <PublicationRow entry={entry} locale={locale} index={i} />)}
      </ol>
    </div>
  </section>

  <section class="section subjects" aria-labelledby="subjects-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="label" data-index="03">{t.home.subjectsLabel}</p>
          <h2 class="h2" id="subjects-title">{t.home.subjectsTitle}</h2>
        </div>
        <p>{t.home.subjectsText}</p>
      </div>
      <div class="subject-grid">
        {subjectIds.map((id, i) => <SubjectCard id={id} locale={locale} total={bySubject(shown, id).length} delay={(i % 3) * 70} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--nav-h) + clamp(6rem, 13vw, 10rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  /* Fades out at the bottom, so the glow has no hard edge where the hero ends. */
  .aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(#000 55%, transparent);
    -webkit-mask-image: linear-gradient(#000 55%, transparent);
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    animation: drift 22s ease-in-out infinite alternate;
  }

  .blob--violet {
    width: 46rem;
    height: 34rem;
    right: -12rem;
    top: -8rem;
    background: rgb(139 92 246 / 0.34);
  }

  .blob--blue {
    width: 36rem;
    height: 26rem;
    left: -16rem;
    bottom: -12rem;
    background: rgb(59 130 246 / 0.18);
    animation-duration: 28s;
    animation-direction: alternate-reverse;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000, transparent);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000, transparent);
  }

  @keyframes drift {
    to {
      transform: translate3d(-5rem, 3rem, 0) scale(1.12);
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1rem;
    border-radius: var(--pill);
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px rgb(182 243 106 / 0.18);
  }

  h1 {
    margin-top: 2rem;
    max-width: 18ch;
    font-size: clamp(2.5rem, 6.6vw, 5.6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  /* The accent line is set in the editorial serif, the research site's voice. */
  h1 em {
    display: inline-block;
    padding-bottom: 0.1em;
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.03em;
  }

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 36rem) auto;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-top: 2.25rem;
  }

  .intro {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .stats div {
    padding: 1.25rem 1.5rem 0 0;
  }

  .stats div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .feature-grid {
    display: grid;
    gap: 1.25rem;
  }

  .feature-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Three featured: the newest across the full width, two below it. */
  .feature-grid--3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .feature-grid--3 > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .feature-grid--3 > :global(:first-child .title) {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .subject-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .lead {
      grid-template-columns: 1fr;
    }

    .feature-grid--2,
    .feature-grid--3 {
      grid-template-columns: 1fr;
    }

    .feature-grid--3 > :global(:first-child) {
      grid-column: auto;
    }

    .subject-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .subject-grid {
      grid-template-columns: 1fr;
    }

    .stats div {
      padding-right: 0.75rem;
    }

    .stats div + div {
      padding-left: 0.75rem;
    }
  }
</style>
