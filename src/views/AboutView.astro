---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SubjectIcon from '../components/SubjectIcon.astro';
import { alternatesFor, sectionPath, topicPath, type Locale, type Localized } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import { subjectIds, subjects } from '../data/subjects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The texts of this page. Edit freely – both languages live side by side.
const copy: Localized<{
  title: string;
  lead: string;
  intro: string[];
  interestsTitle: string;
  interestsText: string;
  journeyTitle: string;
  journey: { when: string; what: string; text: string }[];
  approachTitle: string;
  approachIntro: string;
  principles: { title: string; text?: string }[];
  independenceTitle: string;
  independence: string;
  copyrightTitle: string;
  copyright: string[];
  portfolioTitle: string;
  portfolioText: string;
  portfolioCta: string;
}> = {
  en: {
    title: 'A little about me.',
    lead: 'I’m Jasmin, a software development apprentice with a curiosity for all kinds of subjects. I enjoy learning new things, exploring different ideas and understanding how the world works.',
    intro: [
      'I’ve always been someone who enjoys learning, especially when something catches my interest and makes me want to understand it better. My interests range from astronomy and psychology to languages, history and computer science.',
      'I created this website as a place to organise what I learn and share it with others. Some topics become short summaries or study notes, while others turn into more detailed research papers. It’s also a way for me to look back on what I’ve learned and see how my understanding develops over time.',
    ],
    interestsTitle: 'What I study',
    interestsText: 'The shelves of the library. New ones will be added as my interests grow.',
    journeyTitle: 'Learning journey',
    journey: [
      {
        when: 'Now',
        what: 'Software development apprenticeship',
        text: 'I’m currently completing an apprenticeship in application development, where I’m developing my programming and technical skills.',
      },
      {
        when: 'Ongoing',
        what: 'Independent learning',
        text: 'Outside of school and work, I enjoy exploring different subjects through books, articles, videos and my own research.',
      },
      {
        when: '2026',
        what: 'This website',
        text: 'I started this website to collect my notes, research and summaries in one place and share what I learn.',
      },
    ],
    approachTitle: 'My approach',
    approachIntro:
      'I try to understand the subjects I study rather than simply memorise information. When writing summaries or research papers, I aim to use reliable sources, explain things clearly and distinguish established facts from my own interpretations.',
    principles: [
      { title: 'Use reliable sources.' },
      { title: 'Give credit to the original authors.' },
      { title: 'Stay open to different perspectives and new evidence.' },
      { title: 'Clearly distinguish summaries, notes and research papers.' },
      { title: 'Correct mistakes and update information when necessary.' },
    ],
    independenceTitle: 'Independent, not peer-reviewed',
    independence:
      'Nothing here has gone through formal peer review. Treat it as a careful learner’s work: useful as a starting point, not as an authority. Corrections and suggestions are very welcome.',
    copyrightTitle: 'Copyright',
    copyright: [
      'All written content on this site – research papers, reviews, summaries, study notes, language materials and other texts, including their PDF versions – is © Jasmin Loeffel. All rights reserved.',
      'You are welcome to read, link to and quote short passages with attribution, as copyright law allows. Republishing, translating or adapting larger parts needs my permission.',
      'The source code of the website itself is open source under the MIT licence. That licence does not cover the written content.',
    ],
    portfolioTitle: 'The developer side',
    portfolioText: 'Projects, skills and how to reach me are on my developer portfolio.',
    portfolioCta: 'Visit my portfolio',
  },
  de: {
    title: 'Ein bisschen über mich.',
    lead: 'Ich bin Jasmin und mache eine Ausbildung in der Applikationsentwicklung. Neben dem Programmieren interessiere ich mich für ganz unterschiedliche Themen. Ich lerne gerne Neues, beschäftige mich mit verschiedenen Ideen und versuche, die Welt um mich herum besser zu verstehen.',
    intro: [
      'Ich habe schon immer gerne gelernt, besonders wenn mich ein Thema neugierig macht und ich mehr darüber verstehen möchte. Meine Interessen reichen von Astronomie und Psychologie über Sprachen und Geschichte bis hin zur Informatik.',
      'Diese Website habe ich erstellt, um das, was ich lerne, an einem Ort zu sammeln und mit anderen zu teilen. Manche Themen fasse ich in kurzen Texten oder Lernnotizen zusammen, andere beschäftigen mich länger und werden zu ausführlicheren Recherchen. Gleichzeitig kann ich so später zurückblicken und sehen, wie sich mein Wissen und mein Verständnis weiterentwickelt haben.',
    ],
    interestsTitle: 'Was ich lerne',
    interestsText: 'Die Regale der Bibliothek. Neue kommen dazu, wenn meine Interessen wachsen.',
    journeyTitle: 'Mein Lernweg',
    journey: [
      {
        when: 'Jetzt',
        what: 'Ausbildung in der Applikationsentwicklung',
        text: 'Ich mache zurzeit eine Ausbildung in der Applikationsentwicklung und erweitere dabei meine Kenntnisse im Programmieren und in anderen technischen Bereichen.',
      },
      {
        when: 'Laufend',
        what: 'Selbstständiges Lernen',
        text: 'Auch ausserhalb von Schule und Arbeit beschäftige ich mich gerne mit verschiedenen Themen – durch Bücher, Artikel, Videos und eigene Recherchen.',
      },
      {
        when: '2026',
        what: 'Diese Website',
        text: '2026 habe ich diese Website gestartet, um meine Notizen, Recherchen und Zusammenfassungen an einem Ort zu sammeln und mein Wissen mit anderen zu teilen.',
      },
    ],
    approachTitle: 'Meine Herangehensweise',
    approachIntro:
      'Mir ist es wichtig, die Themen, mit denen ich mich beschäftige, wirklich zu verstehen, statt Informationen nur auswendig zu lernen. Bei meinen Zusammenfassungen und Recherchen versuche ich, zuverlässige Quellen zu verwenden, Inhalte verständlich zu erklären und zwischen gesicherten Erkenntnissen und meinen eigenen Interpretationen zu unterscheiden.',
    principles: [
      { title: 'Zuverlässige Quellen verwenden.' },
      { title: 'Die ursprünglichen Autorinnen und Autoren nennen.' },
      { title: 'Offen für andere Perspektiven und neue Erkenntnisse bleiben.' },
      { title: 'Zusammenfassungen, Lernnotizen und ausführliche Recherchen klar unterscheiden.' },
      { title: 'Fehler korrigieren und Informationen bei Bedarf aktualisieren.' },
    ],
    independenceTitle: 'Unabhängig, nicht begutachtet',
    independence:
      'Nichts hier hat ein formelles Peer-Review durchlaufen. Lies es als Arbeit einer sorgfältigen Lernenden: hilfreich als Ausgangspunkt, nicht als Autorität. Korrekturen und Hinweise sind sehr willkommen.',
    copyrightTitle: 'Urheberrecht',
    copyright: [
      'Alle Texte auf dieser Website – Forschungsarbeiten, Übersichten, Zusammenfassungen, Lernnotizen, Sprachmaterial und weitere Inhalte, einschliesslich ihrer PDF-Fassungen – sind © Jasmin Loeffel. Alle Rechte vorbehalten.',
      'Lesen, verlinken und kurze Passagen mit Quellenangabe zitieren ist im Rahmen des Urheberrechts willkommen. Für das Veröffentlichen, Übersetzen oder Bearbeiten grösserer Teile brauchst du meine Erlaubnis.',
      'Der Quellcode der Website selbst ist Open Source unter der MIT-Lizenz. Diese Lizenz gilt nicht für die Texte.',
    ],
    portfolioTitle: 'Die Entwicklerinnen-Seite',
    portfolioText: 'Projekte, Skills und Kontaktmöglichkeiten findest du in meinem Entwickler-Portfolio.',
    portfolioCta: 'Zum Portfolio',
  },
};

const c = copy[locale];
---

<Base
  locale={locale}
  title={t.meta.aboutTitle}
  description={t.meta.aboutDescription}
  alternates={alternatesFor((code) => sectionPath(code, 'about'))}
  active="about"
>
  <header class="page-head">
    <div class="container">
      <p class="label" data-index="§">{t.nav.about}</p>
      <h1 class="page-title">{c.title}</h1>
      <p class="page-intro">{c.lead}</p>
    </div>
  </header>

  <div class="container about">
    <section class="block intro" data-reveal>
      {c.intro.map((p) => <p>{p}</p>)}
    </section>

    <section class="block" aria-labelledby="interests">
      <div class="side">
        <h2 id="interests">{c.interestsTitle}</h2>
        <p>{c.interestsText}</p>
      </div>
      <ul class="interests">
        {
          subjectIds.map((id, i) => (
            <li data-reveal style={`--d: ${i * 50}ms`}>
              <a href={topicPath(locale, id)}>
                <SubjectIcon name={subjects[id].icon} />
                <span>{subjects[id].name[locale]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="journey">
      <div class="side">
        <h2 id="journey">{c.journeyTitle}</h2>
      </div>
      <ol class="timeline">
        {
          c.journey.map((step, i) => (
            <li data-reveal style={`--d: ${i * 70}ms`}>
              <span class="when">{step.when}</span>
              <div>
                <h3>{step.what}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block" id="approach" aria-labelledby="approach-title">
      <div class="side">
        <h2 id="approach-title">{c.approachTitle}</h2>
        <p>{c.approachIntro}</p>
      </div>
      <ol class="principles">
        {
          c.principles.map((p, i) => (
            <li data-reveal style={`--d: ${(i % 2) * 70}ms`}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              {p.text && <p>{p.text}</p>}
            </li>
          ))
        }
        <li class="independent" data-reveal>
          <span class="n">!</span>
          <h3>{c.independenceTitle}</h3>
          <p>{c.independence}</p>
        </li>
      </ol>
    </section>

    <section class="block" id="copyright" aria-labelledby="copyright-title">
      <div class="side">
        <h2 id="copyright-title">{c.copyrightTitle}</h2>
      </div>
      <div class="copyright">
        {c.copyright.map((p) => <p>{p}</p>)}
        <p class="links">
          <a href={`${site.repository}/blob/main/CONTENT-LICENSE.md`} rel="noopener">CONTENT-LICENSE.md</a>
          <a href={`${site.repository}/blob/main/LICENSE`} rel="noopener">LICENSE (MIT)</a>
        </p>
      </div>
    </section>

    <section class="portfolio" data-reveal aria-labelledby="portfolio-title">
      <div>
        <h2 id="portfolio-title">{c.portfolioTitle}</h2>
        <p>{c.portfolioText}</p>
      </div>
      <a class="btn btn--primary" href={site.portfolio} rel="me">{c.portfolioCta}<Arrow /></a>
    </section>
  </div>
</Base>

<style>
  .about {
    display: grid;
    gap: clamp(3.5rem, 7vw, 5.5rem);
  }

  .block {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--nav-h) + 2rem);
  }

  .side h2 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .side p {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .intro {
    display: block;
    max-width: 46rem;
    border-top: 0;
    padding-top: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.9vw, 1.45rem);
    line-height: 1.6;
  }

  .intro p + p {
    margin-top: 1em;
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .interests a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border-radius: var(--r-s);
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      border-color 0.4s var(--ease),
      translate 0.5s var(--ease);
  }

  .interests a:hover {
    border-color: var(--line-strong);
    translate: 0 -2px;
  }

  .interests :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    color: var(--violet-soft);
  }

  .timeline {
    display: grid;
    gap: 0;
    border-left: 1px solid var(--line-strong);
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0 0 2rem 1.75rem;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--violet-soft);
  }

  .timeline li:first-child::before {
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 0 4px rgb(182 243 106 / 0.18);
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--violet-soft);
  }

  .timeline h3,
  .principles h3 {
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .timeline p,
  .principles p {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .principles li {
    padding: 1.4rem;
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .n {
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lime);
  }

  .independent {
    grid-column: 1 / -1;
    border-style: dashed !important;
    background: rgb(139 92 246 / 0.07) !important;
  }

  .copyright {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .copyright p:first-child {
    color: var(--text);
  }

  .copyright .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .copyright .links a {
    color: var(--violet-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .portfolio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--r-l);
    border: 1px solid var(--line);
    background:
      radial-gradient(90% 140% at 100% 0%, rgb(139 92 246 / 0.28), transparent 60%),
      var(--surface);
  }

  .portfolio h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.6rem);
  }

  .portfolio p {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .block {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .interests,
    .principles {
      grid-template-columns: 1fr;
    }

    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
