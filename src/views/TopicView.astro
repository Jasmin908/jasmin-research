---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PublicationCard from '../components/PublicationCard.astro';
import SubjectIcon from '../components/SubjectIcon.astro';
import { alternatesFor, sectionPath, topicPath, type Locale } from '../i18n/config';
import { count, useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import { subjects, type SubjectId } from '../data/subjects';
import { bySubject, forLocale, getPublications } from '../lib/publications';

interface Props {
  locale: Locale;
  subject: SubjectId;
}

const { locale, subject: id } = Astro.props;
const t = useTranslations(locale);
const subject = subjects[id];
const all = await getPublications();
const items = bySubject(forLocale(all, locale), id);
---

<Base
  locale={locale}
  title={`${subject.name[locale]} – ${site.title}`}
  description={subject.description[locale]}
  alternates={alternatesFor((code) => topicPath(code, id))}
  active="topics"
>
  <header class="page-head">
    <div class="container">
      <a class="back" href={sectionPath(locale, 'topics')}><span aria-hidden="true">←</span> {t.topics.all}</a>
      <div class="title-row">
        <span class="icon"><SubjectIcon name={subject.icon} /></span>
        <h1 class="page-title">{subject.name[locale]}</h1>
      </div>
      <p class="page-intro">{subject.description[locale]}</p>
      <p class="meta">
        <span>{count(items.length, t.topics.countOne, t.topics.count, t.topics.countNone)}</span>
        {items.length > 0 && <a class="text-link" href={`${sectionPath(locale, 'publications')}?subject=${id}`}>{t.topics.inLibrary}<Arrow /></a>}
      </p>
    </div>
  </header>

  <div class="container">
    {
      items.length > 0 ? (
        <div class="grid">
          {items.map((entry, i) => (
            <PublicationCard entry={entry} all={all} locale={locale} level="h2" delay={(i % 3) * 70} />
          ))}
        </div>
      ) : (
        <p class="empty">{t.topics.empty}</p>
      )
    }
  </div>
</Base>

<style>
  .back {
    display: inline-flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }

  .back:hover {
    color: var(--text);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .title-row .page-title {
    margin-top: 0;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(3.25rem, 7vw, 4.75rem);
    aspect-ratio: 1;
    border-radius: 20px;
    border: 1px solid rgb(196 181 253 / 0.25);
    background: rgb(139 92 246 / 0.12);
    color: var(--lime);
  }

  .icon :global(svg) {
    width: 55%;
    height: 55%;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .meta .text-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty {
    padding: 4rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-m);
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
