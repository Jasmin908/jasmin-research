---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, localeCodes, locales, type Locale, type Section } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in every language, used for hreflang and the switcher. */
  alternates: Record<Locale, string>;
  /** Languages without a real version of this page (no hreflang for them). */
  missing?: Locale[];
  active?: Section;
  /** 'article' adds article metadata for search engines and social cards. */
  kind?: 'website' | 'article';
  article?: { published: Date; modified?: Date; author: string; tags: string[]; section?: string };
  /** Extra structured data (JSON-LD). */
  schema?: Record<string, unknown>;
}

const { locale, title, description, alternates, missing = [], active, kind = 'website', article, schema } = Astro.props;
const t = useTranslations(locale);

const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(alternates[locale]);
const ogImage = absolute('/og.png');
const real = localeCodes.filter((code) => !missing.includes(code));

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: absolute(locales[defaultLocale].base),
  inLanguage: localeCodes.map((code) => locales[code].htmlLang),
  author: { '@type': 'Person', name: site.name, url: site.portfolio, sameAs: [site.portfolio, site.github] },
};
---

<!doctype html>
<html lang={locales[locale].htmlLang} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={article?.author ?? site.name} />
    <meta name="theme-color" content="#0b0b12" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {real.length > 1 && real.map((code) => <link rel="alternate" hreflang={locales[code].htmlLang} href={absolute(alternates[code])} />)}
    {real.length > 1 && real.includes(defaultLocale) && <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLocale])} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <meta property="og:type" content={kind} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={locales[locale].ogLocale} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          <meta property="article:author" content={article.author} />
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema ?? website)} />

    <!-- Runs before first paint; enables the scroll reveals. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Nav locale={locale} alternates={alternates} missing={missing} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1.1rem;
    border-radius: var(--pill);
    background: var(--lime);
    color: var(--ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
