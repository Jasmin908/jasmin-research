---
// Usable in .mdx publications without importing:
//   <Callout type="note" title="Key idea">Text…</Callout>
interface Props {
  type?: 'note' | 'definition' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;
---

<aside class:list={['callout', `callout--${type}`]}>
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: 1.75em;
    padding: 1.1em 1.35em;
    border-radius: var(--r-s);
    border: 1px solid rgb(196 181 253 / 0.25);
    background: rgb(139 92 246 / 0.07);
    font-size: 0.95em;
  }

  .callout--definition {
    border-color: rgb(182 243 106 / 0.3);
    background: rgb(182 243 106 / 0.04);
  }

  .callout--warning {
    border-color: rgb(251 191 36 / 0.35);
    background: rgb(251 191 36 / 0.05);
  }

  .callout-title {
    margin-bottom: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.7em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .callout--definition .callout-title {
    color: var(--lime);
  }

  .callout--warning .callout-title {
    color: #fbbf24;
  }

  .callout-body > :global(* + *) {
    margin-top: 0.75em;
  }
</style>
