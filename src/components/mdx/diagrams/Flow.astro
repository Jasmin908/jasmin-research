---
// Shared layout for step-by-step diagrams (GitWorkflow, RequestFlow,
// DeployPipeline): steps connected by arrows that carry a short label (for
// example a git command). Plain HTML instead of an image, so the text stays
// sharp, selectable and readable by screen readers at every size.
//
// Layout, based on the diagram's own width (container queries):
// - narrow (phones): one step per row, arrows pointing down;
// - from 28rem (the article column): the same, but each step is a two-column
//   card with the title on the left and the explanation on the right;
// - from 64rem (wider than any article column): steps side by side. In the
//   article column a row would squeeze long words (e.g. "Arbeitsverzeichnis").
export interface Step {
  title: string;
  note?: string;
  /** Highlights the step in lime (for "you" / the result). */
  accent?: boolean;
  /** Small mono label above the title, e.g. "1" or "github.com". */
  tag?: string;
}

interface Props {
  steps: Step[];
  /** One label per gap between steps (steps.length - 1). */
  arrows: string[];
  caption: string;
  label: string;
}

const { steps, arrows, caption, label } = Astro.props;
---

<figure class="flow-diagram" role="group" aria-label={label}>
  <ol class="steps">
    {
      steps.map((step, i) => (
        <>
          <li class:list={['step', step.accent && 'step--accent']}>
            <span class="head">
              {step.tag && <span class="tag">{step.tag}</span>}
              <span class="title">{step.title}</span>
            </span>
            {step.note && <span class="note">{step.note}</span>}
          </li>
          {i < arrows.length && (
            <li class="arrow" aria-hidden="true">
              <code>{arrows[i]}</code>
            </li>
          )}
        </>
      ))
    }
  </ol>
  <slot />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .flow-diagram {
    margin-block: 2em;
    padding: 1.1rem;
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 100% at 100% 0%, rgb(139 92 246 / 0.1), transparent 60%),
      var(--surface);
    font-family: var(--font-body);
    container-type: inline-size;
  }

  .steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-radius: var(--r-s);
    border: 1px solid var(--line-strong);
    background: rgb(11 11 18 / 0.35);
  }

  .step--accent {
    border-color: rgb(182 243 106 / 0.45);
    background: rgb(182 243 106 / 0.06);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .step--accent .title {
    color: var(--lime);
  }

  .note {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Arrow pointing down, label to its right. */
  .arrow {
    position: relative;
    display: flex;
    align-items: center;
    height: 2.4rem;
    margin: 0;
    padding-left: calc(1.6rem + 0.75rem);
  }

  .arrow::before {
    content: '';
    position: absolute;
    left: 1.6rem;
    top: 0.2rem;
    bottom: 0.45rem;
    width: 1px;
    background: var(--violet-soft);
  }

  .arrow::after {
    content: '';
    position: absolute;
    left: 1.6rem;
    bottom: 0.45rem;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid var(--violet-soft);
    border-top: 1px solid var(--violet-soft);
    transform: translateX(-50%) rotate(135deg);
  }

  .arrow code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
    color: var(--muted);
    background: none;
    padding: 0;
  }

  figcaption {
    margin-top: 0.9em;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Article column: title left, explanation right. */
  @container (min-width: 28rem) {
    .step {
      display: grid;
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      gap: 0.4rem 1.25rem;
      align-items: start;
    }
  }

  /* Very wide containers: steps side by side, arrows pointing right. */
  @container (min-width: 64rem) {
    .steps {
      flex-direction: row;
      align-items: stretch;
    }

    .step {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .arrow {
      flex: 0 0 auto;
      height: auto;
      min-width: 5rem;
      justify-content: center;
      padding: 0 0.4rem;
    }

    .arrow::before {
      left: 0.4rem;
      right: 0.55rem;
      top: 50%;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .arrow::after {
      left: auto;
      right: 0.5rem;
      top: 50%;
      bottom: auto;
      transform: translateY(-50%) rotate(45deg);
    }

    .arrow code {
      position: relative;
      top: -0.95rem;
    }
  }
</style>
