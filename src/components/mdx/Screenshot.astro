---
// A screenshot of a real interface, usable in .mdx publications without importing:
//
//   <Screenshot
//     name="github-new-repository"
//     alt="What the image shows, for screen readers"
//     caption="What readers should notice"
//     capture="Instructions for whoever takes the screenshot"
//   />
//
// The image is looked up by `name` in src/assets/screenshots/ (png, jpg or webp).
// To add or replace a screenshot, save the file there under that name; nothing
// in the article has to change. Images are converted to WebP in several sizes,
// and readers can click to see the full-size version.
//
// While the file is missing, `astro dev` shows a placeholder with the capture
// instructions. A production build fails instead, so a published article can
// never go live with a placeholder. (Drafts are not built in production.)
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  capture?: string;
}

const { name, alt, caption, capture } = Astro.props;
const en = Astro.url.pathname.startsWith('/en/');

// Loaded on demand. Every file in the folder is still copied to the build
// output (unlinked), so keep only screenshots that an article uses.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*.{png,jpg,jpeg,webp}');
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === name);
const image = match ? (await match[1]()).default : undefined;

if (!image && !import.meta.env.DEV) {
  throw new Error(
    `Screenshot "${name}" is missing on ${Astro.url.pathname}. ` +
      `Add src/assets/screenshots/${name}.png, or keep the article as a draft.`,
  );
}

// Responsive widths up to the size of the original; never upscale.
const widths = image ? [480, 768, 1080, 1440].filter((w) => w < image.width).concat(image.width) : [];
const full = image ? await getImage({ src: image, format: 'webp', width: Math.min(image.width, 2400), quality: 85 }) : undefined;

const t = en
  ? { needed: 'Screenshot needed', file: 'Save as', enlarge: 'Open full-size image', close: 'Close' }
  : { needed: 'Screenshot fehlt', file: 'Speichern als', enlarge: 'Bild in voller Grösse öffnen', close: 'Schliessen' };
---

<figure class="shot">
  {
    image && full ? (
      <a class="shot-link" href={full.src} data-zoom aria-label={`${t.enlarge}: ${alt}`} data-close={t.close}>
        <Image
          src={image}
          alt={alt}
          widths={widths}
          sizes="(max-width: 720px) 100vw, 42rem"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
        <span class="zoom-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    ) : (
      <div class="placeholder" role="note">
        <p class="placeholder-label">{t.needed}</p>
        <p class="placeholder-alt">{alt}</p>
        {capture && <p class="placeholder-capture">{capture}</p>}
        <p class="placeholder-file">
          {t.file} <code>src/assets/screenshots/{name}.png</code>
        </p>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Opens the full-size image in a dialog. Without JavaScript the link simply
  // opens the image itself.
  let dialog: HTMLDialogElement | undefined;

  function open(link: HTMLAnchorElement) {
    if (!dialog) {
      dialog = document.createElement('dialog');
      dialog.className = 'shot-dialog';
      dialog.innerHTML = '<button type="button" class="shot-close"></button><img alt="" />';
      dialog.addEventListener('click', (event) => {
        // A click anywhere closes it, except when it lands on the image itself.
        if ((event.target as HTMLElement).tagName !== 'IMG') dialog!.close();
      });
      document.body.append(dialog);
    }
    const img = dialog.querySelector('img')!;
    img.src = link.href;
    img.alt = link.querySelector('img')?.alt ?? '';
    dialog.querySelector('button')!.textContent = link.dataset.close ?? 'Close';
    dialog.showModal();
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-zoom]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    open(link);
  });
</script>

<style>
  .shot {
    margin-block: 2em;
  }

  .shot-link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--r-s);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    cursor: zoom-in;
  }

  .shot-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .zoom-hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--pill);
    background: rgb(11 11 18 / 0.75);
    color: var(--text);
    opacity: 0.85;
    transition: opacity 0.2s var(--ease);
  }

  .zoom-hint svg {
    width: 1rem;
    height: 1rem;
  }

  .shot-link:hover .zoom-hint,
  .shot-link:focus-visible .zoom-hint {
    opacity: 1;
  }

  .placeholder {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--r-s);
    border: 1px dashed rgb(182 243 106 / 0.45);
    background: rgb(182 243 106 / 0.04);
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .placeholder-alt {
    color: var(--text);
  }

  .placeholder-file code {
    overflow-wrap: anywhere;
  }

  figcaption {
    margin-top: 0.75em;
    font-family: var(--font-body);
    font-size: 0.75em;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The dialog is created by the script, so its styles are global. */
  :global(.shot-dialog) {
    max-width: min(96vw, 1600px);
    max-height: 94vh;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-s);
    background: var(--bg);
    overflow: auto;
  }

  :global(.shot-dialog::backdrop) {
    background: rgb(5 5 10 / 0.85);
  }

  :global(.shot-dialog img) {
    display: block;
    max-width: none;
    width: auto;
    max-height: none;
  }

  :global(.shot-close) {
    position: sticky;
    top: 0.5rem;
    left: 100%;
    float: right;
    margin: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    background: rgb(11 11 18 / 0.85);
    color: var(--text);
    font: 500 0.8rem var(--font-body);
    cursor: pointer;
  }
</style>
