---
// The 46 basic hiragana or katakana in gojūon order, with Hepburn romaji.
//   <KanaChart script="hiragana" />   or   <KanaChart script="katakana" />
interface Props {
  script: 'hiragana' | 'katakana';
}

const { script } = Astro.props;
const en = Astro.url.pathname.startsWith('/en/');

// Each row: five slots (a, i, u, e, o). null = no character in that slot.
const rows: [string, ([string, string, string] | null)[]][] = [
  ['', [['あ', 'ア', 'a'], ['い', 'イ', 'i'], ['う', 'ウ', 'u'], ['え', 'エ', 'e'], ['お', 'オ', 'o']]],
  ['k', [['か', 'カ', 'ka'], ['き', 'キ', 'ki'], ['く', 'ク', 'ku'], ['け', 'ケ', 'ke'], ['こ', 'コ', 'ko']]],
  ['s', [['さ', 'サ', 'sa'], ['し', 'シ', 'shi'], ['す', 'ス', 'su'], ['せ', 'セ', 'se'], ['そ', 'ソ', 'so']]],
  ['t', [['た', 'タ', 'ta'], ['ち', 'チ', 'chi'], ['つ', 'ツ', 'tsu'], ['て', 'テ', 'te'], ['と', 'ト', 'to']]],
  ['n', [['な', 'ナ', 'na'], ['に', 'ニ', 'ni'], ['ぬ', 'ヌ', 'nu'], ['ね', 'ネ', 'ne'], ['の', 'ノ', 'no']]],
  ['h', [['は', 'ハ', 'ha'], ['ひ', 'ヒ', 'hi'], ['ふ', 'フ', 'fu'], ['へ', 'ヘ', 'he'], ['ほ', 'ホ', 'ho']]],
  ['m', [['ま', 'マ', 'ma'], ['み', 'ミ', 'mi'], ['む', 'ム', 'mu'], ['め', 'メ', 'me'], ['も', 'モ', 'mo']]],
  ['y', [['や', 'ヤ', 'ya'], null, ['ゆ', 'ユ', 'yu'], null, ['よ', 'ヨ', 'yo']]],
  ['r', [['ら', 'ラ', 'ra'], ['り', 'リ', 'ri'], ['る', 'ル', 'ru'], ['れ', 'レ', 're'], ['ろ', 'ロ', 'ro']]],
  ['w', [['わ', 'ワ', 'wa'], null, null, null, ['を', 'ヲ', 'o (wo)']]],
  ['', [['ん', 'ン', 'n'], null, null, null, null]],
];

const index = script === 'hiragana' ? 0 : 1;
const name = script === 'hiragana' ? 'Hiragana' : 'Katakana';
const caption = en
  ? `${name}: the 46 basic characters with romaji (Hepburn system).`
  : `${name}: die 46 Grundzeichen mit Romaji (Hepburn-System).`;
const total = rows.flatMap(([, cells]) => cells).filter(Boolean).length;
---

<figure class="kana" data-count={total}>
  <div class="grid" role="table" aria-label={caption}>
    {
      rows.map(([, cells]) => (
        <div class="row" role="row">
          {cells.map((cell) =>
            cell ? (
              <div class="cell" role="cell">
                <span class="char" lang="ja">{cell[index]}</span>
                <span class="romaji">{cell[2]}</span>
              </div>
            ) : (
              <div class="cell cell--empty" role="cell" aria-hidden="true" />
            ),
          )}
        </div>
      ))
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .kana {
    margin-block: 1.75em;
  }

  .grid {
    display: grid;
    gap: 0.4rem;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.55rem 0.25rem 0.45rem;
    border-radius: var(--r-s);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.3s var(--ease);
  }

  .cell:hover {
    border-color: rgb(196 181 253 / 0.45);
  }

  .cell--empty {
    border-style: dashed;
    background: transparent;
    opacity: 0.35;
  }

  .char {
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', 'Noto Sans CJK JP', 'Yu Gothic', 'Meiryo', sans-serif;
    font-size: clamp(1.35rem, 4vw, 1.75rem);
    line-height: 1.2;
    color: var(--text);
  }

  .romaji {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--violet-soft);
  }

  figcaption {
    margin-top: 0.75em;
    font-family: var(--font-body);
    font-size: 0.75em;
    color: var(--muted);
  }
</style>
