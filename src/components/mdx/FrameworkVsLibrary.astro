---
// Diagram: who calls whom with a library versus a framework.
// Labels follow the language of the page (English under /en/).
const en = Astro.url.pathname.startsWith('/en/');
const t = en
  ? {
      library: 'Library',
      framework: 'Framework',
      yourCode: 'Your code',
      libCode: 'Library',
      fwCode: 'Framework',
      calls: 'calls',
      libNote: 'You are in control and call the library when you need it.',
      fwNote: 'The framework is in control and calls your code at the right moment.',
      caption: 'Library versus framework: the direction of control is reversed (“inversion of control”).',
    }
  : {
      library: 'Bibliothek',
      framework: 'Framework',
      yourCode: 'Dein Code',
      libCode: 'Bibliothek',
      fwCode: 'Framework',
      calls: 'ruft auf',
      libNote: 'Du hast die Kontrolle und rufst die Bibliothek auf, wenn du sie brauchst.',
      fwNote: 'Das Framework hat die Kontrolle und ruft deinen Code im richtigen Moment auf.',
      caption: 'Bibliothek und Framework: Die Richtung der Kontrolle ist umgekehrt („Inversion of Control“).',
    };
---

<figure class="diagram">
  <div class="panels">
    <div class="panel">
      <p class="panel-title">{t.library}</p>
      <div class="flow">
        <span class="box box--you">{t.yourCode}</span>
        <span class="arrow"><span>{t.calls}</span></span>
        <span class="box">{t.libCode}</span>
      </div>
      <p class="note">{t.libNote}</p>
    </div>
    <div class="panel panel--fw">
      <p class="panel-title">{t.framework}</p>
      <div class="flow">
        <span class="box">{t.fwCode}</span>
        <span class="arrow"><span>{t.calls}</span></span>
        <span class="box box--you">{t.yourCode}</span>
      </div>
      <p class="note">{t.fwNote}</p>
    </div>
  </div>
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  .diagram {
    margin-block: 2em;
    font-family: var(--font-body);
  }

  .panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .panel {
    padding: 1.1rem;
    border-radius: var(--r-m);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .panel--fw {
    background:
      radial-gradient(120% 100% at 100% 0%, rgb(139 92 246 / 0.14), transparent 60%),
      var(--surface);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    margin-top: 0.9rem;
  }

  .box {
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-s);
    border: 1px solid var(--line-strong);
    text-align: center;
    font-size: 0.9rem;
    font-weight: 560;
    color: var(--text);
  }

  .box--you {
    border-color: rgb(182 243 106 / 0.45);
    background: rgb(182 243 106 / 0.06);
    color: var(--lime);
  }

  /* Downward arrow with its label. */
  .arrow {
    position: relative;
    display: flex;
    justify-content: center;
    height: 2.1rem;
  }

  .arrow::before {
    content: '';
    width: 1px;
    height: 100%;
    background: var(--violet-soft);
  }

  .arrow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid var(--violet-soft);
    border-bottom: 1px solid var(--violet-soft);
    transform: translate(-50%, -1px) rotate(45deg);
  }

  .arrow span {
    position: absolute;
    top: 50%;
    left: calc(50% + 0.6rem);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .note {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  figcaption {
    margin-top: 0.75em;
    font-size: 0.75em;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }
</style>
