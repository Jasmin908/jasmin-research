---
// Small line icons for subjects, drawn on a 24px grid with the same stroke style.
import type { Subject } from '../data/subjects';

interface Props {
  name: Subject['icon'];
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['subject-icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'orbit' && (
      <>
        <circle cx="12" cy="12" r="3.25" />
        <ellipse cx="12" cy="12" rx="10" ry="4.25" transform="rotate(-24 12 12)" />
        <circle cx="19.6" cy="7.6" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'mind' && (
      <>
        <circle cx="9" cy="12" r="5.5" />
        <circle cx="15" cy="12" r="5.5" />
        <path d="M12 7.6v8.8" stroke-dasharray="1.5 2" />
      </>
    )
  }
  {
    name === 'speech' && (
      <>
        <path d="M4 5.5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-9l-4.5 3.5v-3.5H4a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z" />
        <path d="M7.5 9.5h9M7.5 12.5h5.5" />
      </>
    )
  }
  {
    name === 'column' && (
      <>
        <path d="M3.5 6.5 12 3l8.5 3.5M4.5 8.5h15M4 20.5h16M5.5 18h13" />
        <path d="M7 10.5V16M12 10.5V16M17 10.5V16" />
      </>
    )
  }
  {
    name === 'hourglass' && (
      <>
        <path d="M6 3.5h12M6 20.5h12" />
        <path d="M7.5 3.5c0 4.5 4.5 5.5 4.5 8.5s-4.5 4-4.5 8.5M16.5 3.5c0 4.5-4.5 5.5-4.5 8.5s4.5 4 4.5 8.5" />
        <path d="M10 18.5h4" />
      </>
    )
  }
  {
    name === 'code' && (
      <>
        <path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4.5l-3 15" />
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z" />
        <path d="M19 16.5v4M17 18.5h4" />
      </>
    )
  }
</svg>
