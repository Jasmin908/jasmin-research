---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { homePath, localeCodes, locales, sectionPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

// Cloudflare Pages serves this single file for every unknown URL,
// so it speaks all languages. Only the first language gets the h1.
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 – Jasmin Loeffel · Research</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <a href="/" aria-label="Jasmin Loeffel · Research"><Logo /></a>
      <p class="code" aria-hidden="true">404</p>
      {
        localeCodes.map((code, index) => {
          const t = useTranslations(code);
          const Heading = index === 0 ? 'h1' : 'h2';
          return (
            <section lang={locales[code].htmlLang}>
              <Heading class="title">{t.notFound.title}</Heading>
              <p>{t.notFound.text}</p>
              <div class="actions">
                <a class="btn btn--ghost" href={homePath(code)}>
                  {t.notFound.cta}
                </a>
                <a class="text-link" href={sectionPath(code, 'publications')}>
                  {t.notFound.library} <span aria-hidden="true">→</span>
                </a>
              </div>
            </section>
          );
        })
      }
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    align-content: center;
    gap: 2.5rem;
    min-height: 100svh;
    width: min(100% - 2.5rem, 40rem);
    margin-inline: auto;
    padding-block: 3rem;
  }

  .code {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(5rem, 22vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .title {
    font-size: 1.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  section p {
    margin-block: 0.5rem 1.25rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--muted);
  }
</style>
